# Environment variables for ClipForge AI
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# ==============================================
# REQUIRED – must be set in all environments
# ==============================================
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Optional Supabase keys (if using Edge Functions)
# VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
# SUPABASE_SECRET_KEY=your_secret_key_here

# ==============================================
# OPTIONAL – API keys for various services
# ==============================================
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_HOST=youtube-media-downloader.p.rapidapi.com
YOUTUBE_API_KEY=your_youtube_api_key_here
PEXELS_API_KEY=your_pexels_api_key_here
JAMENDO_CLIENT_ID=your_jamendo_client_id_here

# Google Cloud Speech-to-Text API key (word-level caption transcription).
# Used by the renderer workers (GOOGLE_STT_API_KEY env) and by the
# google-stt Supabase Edge Function (set via `supabase secrets set`).
GOOGLE_STT_API_KEY=your_google_stt_api_key_here

# ==============================================
# NOTES
# ==============================================
# Get your Supabase URL and anon key from:
# Supabase Dashboard → Project Settings → API
#
# The publishable and secret keys are for Supabase Edge Functions
# and can be found in Dashboard → Edge Functions → Settings
