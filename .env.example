# Environment variables for ClipForge AI
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# ==============================================
# REQUIRED – frontend / Supabase Edge Functions
# ==============================================
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Optional Supabase keys (if using Edge Functions)
# VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here
# SUPABASE_SECRET_KEY=your_secret_key_here

# ==============================================
# REQUIRED – renderer/pipeline.ts (the Node worker)
# Set these on whatever host runs `npm run pipeline`
# (e.g. your Railway service), not in the frontend.
# ==============================================
SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Whisper has been replaced with Gemini for transcription (both the
# full-video transcript used for Claude's moment-picking + the "View
# Transcript" UI, and per-clip burned-in captions). No OpenAI key needed.
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.0-flash

# Claude is called through OpenRouter, not api.anthropic.com directly.
OPENROUTER_API_KEY=your_openrouter_api_key_here
# ANTHROPIC_MODEL=anthropic/claude-sonnet-5

RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_HOST=youtube-media-downloader.p.rapidapi.com
PEXELS_API_KEY=your_pexels_api_key_here
JAMENDO_CLIENT_ID=your_jamendo_client_id_here

# ==============================================
# OPTIONAL – used by the frontend/edge functions, not the pipeline worker
# ==============================================
YOUTUBE_API_KEY=your_youtube_api_key_here

# ==============================================
# NOTES
# ==============================================
# Get your Supabase URL and anon key from:
# Supabase Dashboard → Project Settings → API
#
# The service role key is for the pipeline worker only — never expose it
# to the frontend/browser. Find it in Dashboard → Project Settings → API.

