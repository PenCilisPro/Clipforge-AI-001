# --- Frontend (Vite) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Workers (renderer/) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
OPENAI_API_KEY=sk-...            # Whisper transcription + AI clip analysis

# Optional automatic B-roll / music for the pipeline worker
PEXELS_API_KEY=
JAMENDO_CLIENT_ID=

# --- Supabase Edge Function secrets (set with `supabase secrets set`) ---
# PEXELS_API_KEY, PIXABAY_API_KEY, COVERR_API_KEY   - B-roll search
# JAMENDO_CLIENT_ID                                  - music search
# GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET             - YouTube OAuth + upload
# TIKTOK_CLIENT_KEY, TIKTOK_CLIENT_SECRET            - TikTok OAuth + publish
# YOUTUBE_API_KEY                                    - analytics sync
# OPENROUTER_API_KEY                                  - Claude CSV performance analysis
# OPENROUTER_MODEL                                    - optional, defaults to anthropic/claude-sonnet-4
# APP_URL                                            - frontend URL for OAuth redirects
# RENDER_WORKER_WEBHOOK_URL                          - optional render worker webhook
